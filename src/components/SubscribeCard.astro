---
import { PLATFORM_NAMES } from "../lib/contests/platforms";
import { SUPPORTED_PLATFORMS } from "../lib/preferences/types";

const feeds = [
  { path: "/calendar.ics", label: "All platforms" },
  ...SUPPORTED_PLATFORMS.map((platform) => ({
    path: `/calendar/${platform}.ics`,
    label: PLATFORM_NAMES[platform],
  })),
];
---

<section class="card">
  <h2 class="card-title">Calendar feeds</h2>

  <p class="lead">
    Subscribe once. Google, Apple, and Outlook refresh the feed whenever the
    site is rebuilt.
  </p>

  <ul class="feeds">
    {feeds.map((feed) => (
      <li class="feed">
        <a class="feed-name" href={feed.path}>{feed.label}</a>
        <button class="btn btn-ghost feed-copy" type="button" data-copy={feed.path}>
          Copy
        </button>
      </li>
    ))}
  </ul>

  <p class="hint">
    Google Calendar: <span>Other calendars → From URL</span>. Apple Calendar:
    <span>File → New Calendar Subscription</span>.
  </p>
</section>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy]")
    .forEach((button) => {
      const original = button.textContent ?? "Copy";

      button.addEventListener("click", async () => {
        const path = button.dataset.copy;
        if (!path) return;

        const url = new URL(path, window.location.origin).toString();

        try {
          await navigator.clipboard.writeText(url);
          button.textContent = "Copied";
        } catch {
          button.textContent = "Copy failed";
        }

        window.setTimeout(() => {
          button.textContent = original;
        }, 1500);
      });
    });
</script>

<style>
  .lead {
    margin: 0 0 12px;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .feeds {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .feed {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 2px 4px 2px 10px;
    background: var(--surface-elevated);
  }

  .feed-name {
    flex: 1;
    padding: 6px 0;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .feed-name:hover {
    color: var(--brand);
  }

  .feed-copy {
    height: 24px;
    padding: 0 8px;
    font-size: 0.75rem;
  }

  .hint {
    margin: 0;
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .hint span {
    color: var(--text-muted);
  }
</style>
