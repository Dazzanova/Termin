---
import type { Contest } from "../lib/contests/types";
import { getParticipationStatus } from "../lib/contests/repository";
import { platformMonogram, platformName } from "../lib/contests/platforms";
import { formatDuration } from "../lib/contests/format";

interface Props {
  contest: Contest;
  /** Hide the date column when the row already sits under a day heading. */
  showDate?: boolean;
}

const { contest, showDate = true } = Astro.props;
const currentStatus = getParticipationStatus(contest.id);

const dateLabel = contest.startTime.toLocaleDateString("en-GB", {
  weekday: "short",
  day: "numeric",
  month: "short",
});

const timeLabel = contest.startTime.toLocaleTimeString("en-GB", {
  hour: "2-digit",
  minute: "2-digit",
});

const duration = formatDuration(contest.durationSeconds);
---

<article
  class="contest-card"
  data-start={contest.startTime.toISOString()}
  data-urgency="far"
>
  <div class="contest-when">
    {showDate && <span class="date">{dateLabel}</span>}
    <time class="time" datetime={contest.startTime.toISOString()}>
      {timeLabel}
    </time>
  </div>

  <div class="contest-main">
    <h2 class="contest-name">
      <a href={contest.url} target="_blank" rel="noopener noreferrer">
        {contest.name}
        <span class="external-link" aria-hidden="true">↗</span>
      </a>
    </h2>

    <div class="contest-meta">
      <span class="chip chip-mono">{platformMonogram(contest.platform)}</span>
      <span>{platformName(contest.platform)}</span>
      <span class="sep">·</span>
      <span class="duration">{duration}</span>
    </div>
  </div>

  <div class="contest-actions">
    <span
      id={`participation-error-${contest.id}`}
      class="participation-error"
      aria-live="polite"></span>

    <select
      class="participation-select"
      data-contest-id={contest.id}
      aria-label="Participation status"
      aria-describedby={`participation-error-${contest.id}`}
    >
      <option value="" selected={currentStatus === null}>Not tracked</option>
      <option value="planned" selected={currentStatus === "planned"}>
        Planned
      </option>
      <option value="participated" selected={currentStatus === "participated"}>
        Participated
      </option>
      <option value="skipped" selected={currentStatus === "skipped"}>
        Skipped
      </option>
    </select>

    <div class="contest-countdown" aria-live="polite"></div>
  </div>
</article>

<script>
  import { showToast } from "../lib/ui/toast";

  type Urgency = "far" | "soon" | "critical" | "live";

  function pad(value: number) {
    return String(value).padStart(2, "0");
  }

  async function updateParticipation(
    contestId: string,
    status: string,
    selectEl: HTMLSelectElement
  ) {
    const previousValue = selectEl.value;

    try {
      const response = await fetch("/api/participation", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ contestId, status }),
      });

      if (!response.ok) {
        const errorData = await response.json().catch(() => ({}));
        throw new Error(errorData.error || "Could not update status");
      }
    } catch (error) {
      selectEl.value = previousValue;
      showToast(
        error instanceof Error ? error.message : "Could not update status",
        "error"
      );
    }
  }

  function formatCountdown(
    start: Date,
    now: Date
  ): { text: string; urgency: Urgency } {
    const diffMs = start.getTime() - now.getTime();
    const oneMin = 60_000;
    const oneHour = 3_600_000;
    const oneDay = 86_400_000;

    if (diffMs <= 0) return { text: "LIVE", urgency: "live" };

    if (diffMs < oneHour) {
      const urgency: Urgency = diffMs < 5 * oneMin ? "critical" : "soon";
      return { text: `${Math.floor(diffMs / oneMin)}m`, urgency };
    }

    if (diffMs < oneDay) {
      const h = Math.floor(diffMs / oneHour);
      const m = Math.floor((diffMs % oneHour) / oneMin);
      const urgency: Urgency = diffMs < 30 * oneMin ? "soon" : "far";
      return { text: `${pad(h)}h ${pad(m)}m`, urgency };
    }

    const startOfToday = new Date(
      now.getFullYear(),
      now.getMonth(),
      now.getDate()
    );
    const startOfTarget = new Date(
      start.getFullYear(),
      start.getMonth(),
      start.getDate()
    );
    const diffDays = Math.round(
      (startOfTarget.getTime() - startOfToday.getTime()) / oneDay
    );

    return {
      text: diffDays === 1 ? "tomorrow" : `${diffDays}d`,
      urgency: "far",
    };
  }

  function tick() {
    const now = new Date();

    document
      .querySelectorAll<HTMLElement>(".contest-card[data-start]")
      .forEach((card) => {
        const start = new Date(card.dataset.start!);
        const { text, urgency } = formatCountdown(start, now);

        const countdown =
          card.querySelector<HTMLElement>(".contest-countdown");

        if (countdown && countdown.textContent !== text) {
          countdown.textContent = text;
        }

        if (card.dataset.urgency !== urgency) {
          card.dataset.urgency = urgency;

          if (urgency === "live") {
            card.classList.remove("pulse-once");
            void card.offsetWidth;
            card.classList.add("pulse-once");
          }
        }
      });
  }

  document.querySelectorAll<HTMLSelectElement>(".participation-select").forEach(
    (select) => {
      select.addEventListener("change", (event) => {
        const target = event.target as HTMLSelectElement;
        void updateParticipation(
          target.dataset.contestId!,
          target.value,
          target
        );
      });
    }
  );

  tick();
  window.setInterval(tick, 1000);
</script>

<style>
  .participation-error {
    max-width: 160px;
    color: var(--danger);
    font-size: 0.6875rem;
    font-weight: 550;
  }

  .participation-error:empty {
    display: none;
  }
</style>
