---
import type { Contest } from "../lib/contests/types";

interface Props {
  contest: Contest;
}

const { contest } = Astro.props;

const MONOGRAMS: Record<string, string> = {
  codeforces: "CF",
  atcoder: "AT",
  codechef: "CC",
  leetcode: "LC",
};

const PLATFORM_COLORS: Record<string, string> = {
  codeforces: "#2f8fea",
  atcoder: "#8b5cf6",
  codechef: "#a15f2a",
  leetcode: "#f59f1a",
};

const FALLBACK_COLOR = "#63D6FF";

const platformKey = contest.platform.toLowerCase();
const monogram =
  MONOGRAMS[platformKey] ?? contest.platform.slice(0, 2).toUpperCase();
const badgeColor = PLATFORM_COLORS[platformKey] ?? FALLBACK_COLOR;
const badgeStyleAttr = `background:${badgeColor}22;border:1px solid ${badgeColor}66;color:${badgeColor};`;

const start = contest.startTime.toLocaleString("en-IN", {
  weekday: "short",
  month: "short",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
  hour12: true,
});

const hours = Math.floor(contest.durationSeconds / 3600);
const minutes = Math.floor((contest.durationSeconds % 3600) / 60);
const duration = minutes ? `${hours}h ${minutes}m` : `${hours}h`;
---

<article class="contest-hero" data-start={contest.startTime.toISOString()}>
  <div class="hero-label">Next contest</div>

  <h2 class="hero-title">
    <a href={contest.url} target="_blank" rel="noopener noreferrer">
      {contest.name}
      <span class="external-link" aria-hidden="true">↗</span>
    </a>
  </h2>

  <div class="hero-countdown" aria-live="polite"></div>

  <div class="hero-meta">
    <div class="meta-item">
      <div class="meta-badge" style={badgeStyleAttr}>
        {monogram}
      </div>
      <span class="meta-platform">{contest.platform}</span>
    </div>

    <div class="meta-item">
      <time datetime={contest.startTime.toISOString()} class="meta-text">
        {start}
      </time>
    </div>

    <div class="meta-item">
      <span class="meta-text">{duration}</span>
    </div>
  </div>

  <div class="hero-actions">
    <a href={contest.url} target="_blank" rel="noopener noreferrer" class="hero-btn"
      >Open contest</a
    >
  </div>
</article>

<style>
  .contest-hero {
    padding: 32px 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-elevated);
    margin-bottom: 48px;
  }

  .hero-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .hero-title {
    margin: 0 0 20px;
    font-size: 2.2rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .hero-title a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .hero-title a:hover {
    color: var(--brand);
  }

  .external-link {
    display: inline-block;
    margin-left: 8px;
    font-size: 0.8em;
    color: var(--text-muted);
    transition: color 150ms ease;
  }

  .hero-title a:hover .external-link {
    color: var(--brand);
  }

  .hero-countdown {
    font-size: 3rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    font-family: "JetBrains Mono", "Courier New", monospace;
    color: var(--brand);
    line-height: 1;
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }

  .ct-char {
    display: inline-block;
  }

  .ct-flip {
    animation: heroFlip 280ms ease;
  }

  @keyframes heroFlip {
    0% {
      transform: translateY(-60%);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .meta-badge {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    font-size: 0.65rem;
    font-weight: 800;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
    flex-shrink: 0;
  }

  .meta-platform {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
  }

  .meta-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--brand);
    color: var(--bg);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 150ms ease, transform 100ms ease;
  }

  .hero-btn:hover {
    opacity: 0.9;
  }

  .hero-btn:active {
    transform: translateY(1px);
  }

  @media (max-width: 768px) {
    .contest-hero {
      padding: 24px 20px;
      margin-bottom: 36px;
    }

    .hero-title {
      font-size: 1.8rem;
      margin-bottom: 16px;
    }

    .hero-countdown {
      font-size: 2.2rem;
      margin-bottom: 20px;
    }

    .hero-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 24px;
      padding-bottom: 20px;
    }

    .hero-actions {
      gap: 8px;
    }

    .hero-btn {
      flex: 1;
      padding: 10px 16px;
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ct-flip {
      animation: none;
    }
  }
</style>
