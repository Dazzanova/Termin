---
import type { Contest } from "../lib/contests/types";

interface Props {
  contest: Contest;
}

const { contest } = Astro.props;

const MONOGRAMS: Record<string, string> = {
  codeforces: "CF",
  atcoder: "AT",
  codechef: "CC",
  leetcode: "LC",
};

const PLATFORM_NAMES: Record<string, string> = {
  codeforces: "Codeforces",
  atcoder: "AtCoder",
  codechef: "CodeChef",
  leetcode: "LeetCode",
};

const platformKey = contest.platform.toLowerCase();
const monogram =
  MONOGRAMS[platformKey] ?? contest.platform.slice(0, 2).toUpperCase();
const platformName = PLATFORM_NAMES[platformKey] ?? contest.platform;

const start = contest.startTime.toLocaleString("en-GB", {
  weekday: "short",
  day: "numeric",
  month: "short",
  hour: "2-digit",
  minute: "2-digit",
});

const hours = Math.floor(contest.durationSeconds / 3600);
const minutes = Math.floor((contest.durationSeconds % 3600) / 60);
const duration = `${hours}h ${String(minutes).padStart(2, "0")}m`;
---

<article class="hero" data-start={contest.startTime.toISOString()}>
  <div class="hero-body">
    <p class="hero-label">Up next</p>

    <h2 class="hero-title">
      <a href={contest.url} target="_blank" rel="noopener noreferrer">
        {contest.name}
        <span class="external-link" aria-hidden="true">↗</span>
      </a>
    </h2>

    <div class="hero-meta">
      <span class="chip chip-mono">{monogram}</span>
      <span>{platformName}</span>
      <span class="sep">·</span>
      <time datetime={contest.startTime.toISOString()}>{start}</time>
      <span class="sep">·</span>
      <span class="duration">{duration}</span>
    </div>
  </div>

  <div class="hero-side">
    <div class="hero-countdown" aria-live="polite"></div>
    <a
      class="btn btn-primary"
      href={contest.url}
      target="_blank"
      rel="noopener noreferrer">Open contest</a
    >
  </div>
</article>

<script>
  function pad(value: number) {
    return String(value).padStart(2, "0");
  }

  function heroCountdown(start: Date, now: Date): string {
    const diffMs = start.getTime() - now.getTime();

    if (diffMs <= 0) return "LIVE";

    const oneMin = 60_000;
    const oneHour = 3_600_000;
    const oneDay = 86_400_000;

    if (diffMs < oneHour) return `${Math.floor(diffMs / oneMin)} min`;

    if (diffMs < oneDay) {
      const h = Math.floor(diffMs / oneHour);
      const m = Math.floor((diffMs % oneHour) / oneMin);
      return `${pad(h)}h ${pad(m)}m`;
    }

    const days = Math.floor(diffMs / oneDay);
    const h = Math.floor((diffMs % oneDay) / oneHour);
    return `${days}d ${pad(h)}h`;
  }

  function tick() {
    const hero = document.querySelector<HTMLElement>(".hero[data-start]");
    if (!hero) return;

    const el = hero.querySelector<HTMLElement>(".hero-countdown");
    if (!el) return;

    const text = heroCountdown(new Date(hero.dataset.start!), new Date());
    if (el.textContent !== text) el.textContent = text;
  }

  tick();
  window.setInterval(tick, 1000);
</script>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding: 18px 20px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .hero-body {
    min-width: 0;
    display: grid;
    gap: 6px;
  }

  .hero-label {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .hero-title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .hero-title a {
    color: inherit;
    text-decoration: none;
  }

  .hero-title a:hover {
    color: var(--brand);
  }

  .external-link {
    display: inline-block;
    margin-left: 8px;
    font-size: 0.8em;
    color: var(--text-dim);
    transition: color 120ms ease;
  }

  .hero-title a:hover .external-link {
    color: var(--brand);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .hero-meta .sep {
    color: var(--border-strong);
  }

  .hero-meta .duration {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .hero-side {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hero-countdown {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  @media (max-width: 720px) {
    .hero-side {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
