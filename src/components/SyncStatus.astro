---
import { getSyncState } from "../lib/contests/sync-state";
import type { SyncState } from "../lib/contests/sync-state";

interface Props {
  syncState?: SyncState;
}

const syncState = Astro.props.syncState ?? getSyncState();

function formatTimeAgo(date: Date | null): string {
  if (!date) return "never";

  const diffMs = Date.now() - date.getTime();
  const diffMin = Math.floor(diffMs / 60_000);
  const diffHour = Math.floor(diffMin / 60);
  const diffDay = Math.floor(diffHour / 24);

  if (diffMs < 60_000) return "just now";
  if (diffMin < 60) return `${diffMin}m ago`;
  if (diffHour < 24) return `${diffHour}h ago`;
  if (diffDay < 7) return `${diffDay}d ago`;

  return date.toLocaleDateString("en-GB", { month: "short", day: "numeric" });
}

const isError = syncState.status === "error";
const isSyncing = syncState.status === "syncing";
const neverSynced = syncState.completedAt === null && !isSyncing;

const label = isSyncing
  ? "Syncing"
  : isError
    ? "Sync failed"
    : neverSynced
      ? "Not synced"
      : `Synced ${formatTimeAgo(syncState.completedAt)}`;

const state = isError || neverSynced ? "warning" : isSyncing ? "syncing" : "ok";
---

<div class:list={["sync-status", { syncing: isSyncing }]} title={label}>
  <span class:list={["sync-dot", { warning: state === "warning" }]}></span>
  <span class="sync-label">{label}</span>
</div>
