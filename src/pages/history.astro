---
import "../styles/global.css";
import { getContestHistory } from "../lib/contests/repository";
import type { ParticipationStatus } from "../lib/contests/types";

const statusFilter = Astro.url.searchParams.get('status') as ParticipationStatus | null;
const history = getContestHistory(statusFilter);

const PLATFORM_NAMES: Record<string, string> = {
    codeforces: "Codeforces",
    atcoder: "AtCoder",
    codechef: "CodeChef",
    leetcode: "LeetCode",
};

const PLATFORM_COLORS: Record<string, string> = {
    codeforces: "#2f8fea",
    atcoder: "#8b5cf6",
    codechef: "#a15f2a",
    leetcode: "#f59f1a",
};

const STATUS_LABELS: Record<ParticipationStatus, string> = {
    planned: "Planned",
    participated: "Participated",
    skipped: "Skipped",
};

const STATUS_COLORS: Record<ParticipationStatus, string> = {
    planned: "var(--text-muted)",
    participated: "var(--brand)",
    skipped: "var(--text-dim)",
};
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>History · Termin</title>
    </head>

    <body>
        <main>
            <header class="site-header">
                <div class="header-title">
                    <p class="eyebrow">
                        <a href="/" class="nav-back">
                            ← Back to contests
                        </a>
                    </p>
                    <h1>History</h1>
                    <p class="subtitle">Your contest participation history.</p>
                </div>

                <div class="filter-controls">
                    <span class="filter-label">Filter by status:</span>
                    <div class="filter-buttons">
                        <a href="/history" class="filter-btn" data-active={!statusFilter}>
                            All
                        </a>
                        {Object.entries(STATUS_LABELS).map(([status, label]) => (
                            <a
                                href={`/history?status=${status}`}
                                class="filter-btn"
                                data-active={statusFilter === status}
                            >
                                {label}
                            </a>
                        ))}
                    </div>
                </div>
            </header>

            <section>
                {history.length === 0 ? (
                    <div class="empty-state">
                        <div class="empty-icon">📜</div>
                        <h2>No history found</h2>
                        <p>Participate in contests to see them here.</p>
                    </div>
                ) : (
                    <div class="history-list">
                        {history.map((entry) => (
                            <div class="history-item">
                                <div class="history-platform-badge" style={`background:${PLATFORM_COLORS[entry.platform] || '#4a4a52'}22; border:1px solid ${PLATFORM_COLORS[entry.platform] || '#4a4a52'}66; color:${PLATFORM_COLORS[entry.platform] || '#4a4a52'};`}>
                                    {entry.platform.slice(0, 2).toUpperCase()}
                                </div>

                                <div class="history-main">
                                    <h3 class="history-name">
                                        <a href={entry.url} target="_blank" rel="noopener noreferrer">
                                            {entry.name}
                                        </a>
                                    </h3>
                                    <div class="history-meta">
                                        <time datetime={entry.startTime.toISOString()}>
                                            {entry.startTime.toLocaleDateString("en-IN", {
                                                dateStyle: "medium",
                                            })}
                                        </time>
                                        <span> · {PLATFORM_NAMES[entry.platform] || entry.platform}</span>
                                    </div>
                                </div>

                                <div class="history-status" style={`color: ${STATUS_COLORS[entry.status]};`}>
                                    {STATUS_LABELS[entry.status]}
                                </div>
                            </div>
                        ))}
                    </div>
                )}
            </section>
        </main>

        <style>
            .header-title {
                display: flex;
                flex-direction: column;
                gap: 4px;
            }

            .nav-back {
                color: var(--text-muted);
                text-decoration: none;
                transition: color 150ms ease;
                font-weight: 500;
            }

            .nav-back:hover {
                color: var(--text);
            }

            .filter-controls {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-top: 12px;
            }

            .filter-label {
                font-size: 0.75rem;
                font-weight: 600;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

            .filter-buttons {
                display: flex;
                gap: 6px;
            }

            .filter-btn {
                font-size: 0.75rem;
                font-weight: 500;
                padding: 4px 10px;
                border-radius: var(--radius-sm);
                border: 1px solid var(--border);
                color: var(--text-muted);
                text-decoration: none;
                transition: all 150ms ease;
            }

            .filter-btn:hover {
                border-color: var(--border-strong);
                color: var(--text);
            }

            .filter-btn[data-active="true"] {
                background: var(--brand);
                color: var(--bg);
                border-color: var(--brand);
            }

            .empty-state {
                display: grid;
                place-items: center;
                text-align: center;
                padding: 64px 24px;
                color: var(--text-muted);
            }

            .empty-icon {
                font-size: 3rem;
                margin-bottom: 16px;
            }

            .empty-state h2 {
                font-size: 1.25rem;
                color: var(--text);
                margin-bottom: 8px;
            }

            .history-list {
                display: grid;
                gap: 12px;
            }

            .history-item {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 12px 16px;
                border: 1px solid var(--border);
                border-radius: var(--radius-md);
                background: var(--surface);
                transition: border-color 150ms ease, background 150ms ease;
            }

            .history-item:hover {
                background: var(--surface-hover);
                border-color: var(--border-strong);
            }

            .history-platform-badge {
                flex-shrink: 0;
                display: grid;
                place-items: center;
                width: 36px;
                height: 36px;
                border-radius: var(--radius-sm);
                font-size: 0.65rem;
                font-weight: 800;
            }

            .history-main {
                flex: 1;
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

            .history-name {
                font-size: 0.9rem;
                font-weight: 600;
                margin: 0;
            }

            .history-name a {
                color: var(--text);
                text-decoration: none;
                transition: color 150ms ease;
            }

            .history-name a:hover {
                color: var(--brand);
                text-decoration: underline;
                text-underline-offset: 3px;
            }

            .history-meta {
                font-size: 0.75rem;
                color: var(--text-dim);
            }

            .history-status {
                font-size: 0.75rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

            @media (max-width: 768px) {
                .filter-controls {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 8px;
                }

                .filter-buttons {
                    width: 100%;
                    overflow-x: auto;
                    padding-bottom: 4px;
                }
            }
        </style>
    </body>
</html>
