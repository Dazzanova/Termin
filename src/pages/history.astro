---
import Layout from "../components/Layout.astro";
import { getContestHistory } from "../lib/contests/repository";
import { platformMonogram, platformName } from "../lib/contests/platforms";
import type { ParticipationStatus } from "../lib/contests/types";

const statusFilter = Astro.url.searchParams.get(
  "status"
) as ParticipationStatus | null;

// One read serves both the list and the header counts; filtering in memory
// keeps this to a single query per request.
const allEntries = await getContestHistory();
const history = statusFilter
  ? allEntries.filter((entry) => entry.status === statusFilter)
  : allEntries;

const STATUS_LABELS: Record<ParticipationStatus, string> = {
  planned: "Planned",
  participated: "Participated",
  skipped: "Skipped",
};

const STATUS_CLASS: Record<ParticipationStatus, string> = {
  planned: "chip-accent",
  participated: "chip-success",
  skipped: "",
};

const filters = [
  { href: "/history", label: "All", value: null },
  ...Object.entries(STATUS_LABELS).map(([value, label]) => ({
    href: `/history?status=${value}`,
    label,
    value,
  })),
];

const counts = {
  total: allEntries.length,
  participated: allEntries.filter((entry) => entry.status === "participated")
    .length,
};
---

<Layout
  title="History — Termin"
  active="history"
  description="Which contests you planned and which you actually joined."
>
  <div class="page-head">
    <div>
      <h1>History</h1>
      <p class="subtitle">
        {counts.total} tracked · {counts.participated} participated
      </p>
    </div>

    <nav class="filters" aria-label="Filter by status">
      {filters.map((filter) => (
        <a
          href={filter.href}
          class:list={["filter", { active: statusFilter === filter.value }]}
          aria-current={statusFilter === filter.value ? "true" : undefined}
        >
          {filter.label}
        </a>
      ))}
    </nav>
  </div>

  <section>
    {history.length === 0 ? (
      <div class="empty-state">
        <h3>No tracked contests</h3>
        <p>
          Set a participation status on the dashboard and it will show up here.
        </p>
      </div>
    ) : (
      <div class="contest-list">
        {history.map((entry) => (
          <article class="history-item">
            <div class="contest-when">
              <span class="date">
                {entry.startTime.toLocaleDateString("en-GB", {
                  day: "numeric",
                  month: "short",
                  year: "numeric",
                })}
              </span>
              <time class="time" datetime={entry.startTime.toISOString()}>
                {entry.startTime.toLocaleTimeString("en-GB", {
                  hour: "2-digit",
                  minute: "2-digit",
                })}
              </time>
            </div>

            <div class="contest-main">
              <h2 class="contest-name">
                <a href={entry.url} target="_blank" rel="noopener noreferrer">
                  {entry.name}
                  <span class="external-link" aria-hidden="true">↗</span>
                </a>
              </h2>
              <div class="contest-meta">
                <span class="chip chip-mono">
                  {platformMonogram(entry.platform)}
                </span>
                <span>{platformName(entry.platform)}</span>
              </div>
            </div>

            <span class:list={["chip", STATUS_CLASS[entry.status]]}>
              {STATUS_LABELS[entry.status]}
            </span>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .filters {
    display: flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .filter {
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color 120ms ease,
      background 120ms ease;
  }

  .filter:hover {
    color: var(--text);
    background: var(--surface-hover);
  }

  .filter.active {
    color: var(--text);
    background: var(--surface-hover);
  }

  .history-item {
    display: grid;
    grid-template-columns: 88px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 12px 14px;
    background: var(--surface);
  }

  .history-item:hover {
    background: var(--surface-hover);
  }

  @media (max-width: 720px) {
    .history-item {
      grid-template-columns: 1fr auto;
      row-gap: 8px;
    }

    .history-item .contest-when {
      grid-column: 1 / -1;
      display: flex;
      gap: 8px;
    }
  }
</style>
