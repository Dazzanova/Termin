---
import Layout from "../components/Layout.astro";
import { getPreferences } from "../lib/preferences/repository";
import { SUPPORTED_PLATFORMS } from "../lib/preferences/types";
import { platformMonogram, platformName } from "../lib/contests/platforms";
import type { ContestPlatform } from "../lib/contests/types";
import {
  countProblems,
  getAccount,
  getSolvedProblemIds,
  getTrainingState,
} from "../lib/training/repository";

const preferences = getPreferences();
const trainingAccount = getAccount("codeforces");
const lastImport = getTrainingState("last_import_at");
const problemCount = countProblems();
const solvedCount = getSolvedProblemIds("codeforces").size;

const lastImportLabel = lastImport
  ? new Date(lastImport).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "short",
      hour: "2-digit",
      minute: "2-digit",
    })
  : null;
const enabledSet = new Set<string>(preferences.enabledPlatforms);

const PLATFORM_NOTES: Record<ContestPlatform, string> = {
  codeforces: "Rounds, Div. 1–4, educational",
  atcoder: "Beginner, Regular, Grand",
  codechef: "Starters, long challenges",
  leetcode: "Weekly and biweekly",
};
---

<Layout
  title="Settings — Termin"
  active="settings"
  description="Choose which contest platforms appear in Termin."
>
  <div class="page-head">
    <div>
      <h1>Settings</h1>
      <p class="subtitle">Choose which platforms feed the dashboard and calendar.</p>
    </div>

    <span class="chip chip-mono" id="selection-count">
      {preferences.enabledPlatforms.length}/{SUPPORTED_PLATFORMS.length} enabled
    </span>
  </div>

  <form method="POST" action="/settings">
    <div class="platforms">
      {SUPPORTED_PLATFORMS.map((platform) => (
        <label class="platform-row" for={`platform-${platform}`}>
          <span class="chip chip-mono">{platformMonogram(platform)}</span>

          <span class="platform-main">
            <span class="platform-name">{platformName(platform)}</span>
            <span class="platform-note">{PLATFORM_NOTES[platform]}</span>
          </span>

          <span class="platform-slug">{platform}</span>

          <input
            class="switch-input"
            type="checkbox"
            name="platforms"
            id={`platform-${platform}`}
            value={platform}
            checked={enabledSet.has(platform)}
          />
          <span class="switch" aria-hidden="true"></span>
        </label>
      ))}
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save preferences</button>
      <a class="btn btn-ghost" href="/">Cancel</a>
      <span class="form-hint">
        Saving needs the dev server; a static build is read-only.
      </span>
    </div>
  </form>

  <section class="training">
    <div class="section-heading">
      <h2>Training</h2>
      <span>Codeforces</span>
    </div>

    <p class="training-note">
      Import your submissions to queue every problem you did not solve from
      contests you marked as participated.
    </p>

    <div class="training-row">
      <input
        id="cf-handle"
        class="text-input"
        type="text"
        placeholder="Codeforces handle"
        value={trainingAccount?.handle ?? ""}
        autocomplete="off"
        spellcheck="false"
        aria-label="Codeforces handle"
      />
      <button id="import-button" class="btn btn-primary" type="button">
        Link &amp; import
      </button>
    </div>

    <p class="form-hint" id="import-status">
      {lastImportLabel
        ? `Last import ${lastImportLabel} · ${problemCount} problems · ${solvedCount} solved`
        : `Never imported · ${problemCount} problems · ${solvedCount} solved`}
    </p>
  </section>
</Layout>

<script>
  const inputs = document.querySelectorAll<HTMLInputElement>(".switch-input");
  const countEl = document.getElementById("selection-count");
  const total = inputs.length;

  function updateCount() {
    const enabled = Array.from(inputs).filter((input) => input.checked).length;
    if (countEl) {
      countEl.textContent = `${enabled}/${total} enabled`;
    }
  }

  inputs.forEach((input) => input.addEventListener("change", updateCount));
  updateCount();
</script>

<style>
  .platforms {
    display: grid;
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .platform-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: var(--surface);
    cursor: pointer;
    transition: background 120ms ease;
  }

  .platform-row:hover {
    background: var(--surface-hover);
  }

  .platform-main {
    display: grid;
    gap: 1px;
    flex: 1;
    min-width: 0;
  }

  .platform-name {
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--text);
  }

  .platform-note {
    font-size: 0.6875rem;
    color: var(--text-dim);
  }

  .platform-slug {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-dim);
  }

  .switch-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .switch {
    position: relative;
    flex-shrink: 0;
    width: 32px;
    height: 18px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface-elevated);
    transition:
      background 140ms ease,
      border-color 140ms ease;
  }

  .switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--text-dim);
    transition:
      transform 140ms ease,
      background 140ms ease;
  }

  .switch-input:checked + .switch {
    background: var(--accent-soft);
    border-color: var(--accent-line);
  }

  .switch-input:checked + .switch::after {
    transform: translateX(14px);
    background: var(--brand);
  }

  .switch-input:focus-visible + .switch {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .form-hint {
    font-size: 0.6875rem;
    color: var(--text-dim);
  }
  .training {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border-subtle);
    max-width: 720px;
  }

  .training-note {
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.6;
    margin: 0 0 12px;
    max-width: 62ch;
  }

  .training-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .text-input {
    flex: 1;
    min-width: 220px;
    height: 34px;
    padding: 0 10px;
    color: var(--text);
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .text-input::placeholder {
    color: var(--text-dim);
  }

  .text-input:focus-visible {
    outline: none;
    border-color: var(--accent-line);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  #import-status {
    margin-top: 10px;
  }
</style>

<script>
  import { showToast } from "../lib/ui/toast";

  const handleInput = document.getElementById(
    "cf-handle"
  ) as HTMLInputElement | null;
  const importButton = document.getElementById(
    "import-button"
  ) as HTMLButtonElement | null;
  const importStatus = document.getElementById("import-status");

  // The handle field is outside the preferences form, so Enter needs its own
  // shortcut to the import button.
  handleInput?.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      event.preventDefault();
      importButton?.click();
    }
  });

  importButton?.addEventListener("click", async () => {
    const handle = handleInput?.value.trim() ?? "";

    if (!handle) {
      showToast("Enter a Codeforces handle", "error");
      return;
    }

    const original = importButton.textContent ?? "Link & import";
    importButton.disabled = true;
    importButton.textContent = "Importing…";

    if (importStatus) {
      importStatus.textContent = "Fetching problems and submissions…";
    }

    try {
      const response = await fetch("/api/training/account", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ handle }),
      });

      if (response.status === 404) {
        showToast("Imports need the dev server (npm run dev)", "error");
        return;
      }

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data.error ?? "Import failed");
      }

      showToast(
        `Imported ${data.problems} problems · ${data.solved} solved · ${data.queuedReviews} queued`
      );
      window.setTimeout(() => window.location.reload(), 1200);
    } catch (error) {
      showToast(
        error instanceof Error ? error.message : "Import failed",
        "error"
      );
      if (importStatus) {
        importStatus.textContent = "Import failed — try again.";
      }
    } finally {
      importButton.disabled = false;
      importButton.textContent = original;
    }
  });
</script>
