---
import Layout from "../components/Layout.astro";
import ContestCard from "../components/ContestCard.astro";
import ContestHero from "../components/ContestHero.astro";
import SubscribeCard from "../components/SubscribeCard.astro";
import { getUpcomingContests } from "../lib/contests/getUpcomingContests";
import { PLATFORM_NAMES, platformMonogram, platformName } from "../lib/contests/platforms";
import type { Contest, ContestPlatform } from "../lib/contests/types";
import {
  getAccount,
  getReviewCounts,
  listDueReviews,
} from "../lib/training/repository";

const contests = await getUpcomingContests();
const nextContest = contests.length > 0 ? contests[0] : null;

const trainingAccount = await getAccount("codeforces");
const trainingCounts = trainingAccount ? await getReviewCounts() : null;
const dueReviews = trainingAccount ? await listDueReviews(new Date(), 2) : [];

function dayLabel(date: Date, now: Date): string {
  const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const startOfDay = new Date(date.getFullYear(), date.getMonth(), date.getDate());
  const diffDays = Math.round(
    (startOfDay.getTime() - startOfToday.getTime()) / 86_400_000
  );

  if (diffDays === 0) return "Today";
  if (diffDays === 1) return "Tomorrow";

  return date.toLocaleDateString("en-GB", {
    weekday: "short",
    day: "numeric",
    month: "short",
  });
}

const now = new Date();
const groups: { label: string; contests: Contest[] }[] = [];

for (const contest of contests) {
  const label = dayLabel(contest.startTime, now);
  const existing = groups.find((group) => group.label === label);

  if (existing) {
    existing.contests.push(contest);
  } else {
    groups.push({ label, contests: [contest] });
  }
}

const coverage = (Object.keys(PLATFORM_NAMES) as ContestPlatform[])
  .map((platform) => ({
    platform,
    name: platformName(platform),
    monogram: platformMonogram(platform),
    count: contests.filter((contest) => contest.platform === platform).length,
  }))
  .filter((entry) => entry.count > 0);
---

<Layout
  title="Termin — Contest dashboard"
  active="contests"
  description="Every upcoming competitive programming contest in one place."
>
  <div class="page-head">
    <div>
      <h1>Contests</h1>
      <p class="subtitle">
        {contests.length} upcoming
        {coverage.length > 0 && ` across ${coverage.length} platforms`}
      </p>
    </div>
  </div>

  {nextContest && <ContestHero contest={nextContest} />}

  <section>
    <div class="section-heading">
      <h2>Upcoming</h2>
      <span>{contests.length} total</span>
    </div>

    {contests.length === 0 ? (
      <div class="empty-state">
        <h3>No upcoming contests</h3>
        <p>
          Use the <code>Sync</code> button in the top bar to fetch the
          current schedule.
        </p>
      </div>
    ) : (
      groups.map((group) => (
        <div class="day-group">
          <p class="day-label">{group.label}</p>
          <div class="contest-list">
            {group.contests.map((contest) => (
              <ContestCard contest={contest} showDate={false} />
            ))}
          </div>
        </div>
      ))
    )}
  </section>

  <div slot="rail">
    {trainingAccount && trainingCounts && (
      <section class="card">
        <h2 class="card-title">Training</h2>

        <div class="train-head">
          <span class="train-count">{trainingCounts.due}</span>
          <span class="train-label">
            {trainingCounts.due === 1 ? "review due" : "reviews due"}
          </span>
        </div>

        {dueReviews.length > 0 ? (
          <ul class="train-list">
            {dueReviews.map((entry) => (
              <li>
                <a
                  href={entry.problem.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {entry.problem.name}
                </a>
                {entry.problem.rating && (
                  <span class="train-rating">{entry.problem.rating}</span>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="train-empty">
            {trainingCounts.upcoming} scheduled · nothing due
          </p>
        )}

        <a class="btn train-link" href="/practice">Open practice</a>
      </section>
    )}

    <SubscribeCard />

    {coverage.length > 0 && (
      <section class="card">
        <h2 class="card-title">Coverage</h2>
        <ul class="coverage">
          {coverage.map((entry) => (
            <li>
              <span class="chip chip-mono">{entry.monogram}</span>
              <span class="coverage-name">{entry.name}</span>
              <span class="coverage-count">{entry.count}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>

<style>
  .train-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 10px;
  }

  .train-count {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--text);
  }

  .train-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .train-list {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .train-list li {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 0.8125rem;
  }

  .train-list a {
    color: var(--text-secondary);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .train-list a:hover {
    color: var(--brand);
  }

  .train-rating {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .train-empty {
    margin: 0 0 12px;
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .train-link {
    width: 100%;
    justify-content: center;
  }

  .coverage {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .coverage li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8125rem;
  }

  .coverage-name {
    flex: 1;
    color: var(--text-secondary);
  }

  .coverage-count {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }
</style>
