---
import "../styles/global.css";
import ContestCard from "../components/ContestCard.astro";
import ContestHero from "../components/ContestHero.astro";
import SyncStatus from "../components/SyncStatus.astro";
import { getUpcomingContests } from "../lib/contests/getUpcomingContests";
import { getSyncState } from "../lib/contests/sync-state";
import type { Contest } from "../lib/contests/types";

const contests = getUpcomingContests();
const syncState = getSyncState();
const nextContest = contests.length > 0 ? contests[0] : null;

function dayLabel(date: Date, now: Date): string {
    const startOfToday = new Date(
        now.getFullYear(),
        now.getMonth(),
        now.getDate(),
    );
    const startOfDay = new Date(
        date.getFullYear(),
        date.getMonth(),
        date.getDate(),
    );
    const diffDays = Math.round(
        (startOfDay.getTime() - startOfToday.getTime()) / 86_400_000,
    );

    if (diffDays === 0) return "Today";
    if (diffDays === 1) return "Tomorrow";

    return date.toLocaleDateString("en-IN", {
        weekday: "short",
        day: "numeric",
        month: "short",
    });
}

const now = new Date();

const groups: { label: string; contests: Contest[] }[] = [];

for (const contest of contests) {
    const label = dayLabel(contest.startTime, now);
    const existing = groups.find((group) => group.label === label);

    if (existing) {
        existing.contests.push(contest);
    } else {
        groups.push({ label, contests: [contest] });
    }
}
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta
            name="description"
            content="Your friendly competitive programming contest reminder."
        />
        <title>Termin</title>
    </head>

    <body>
        <main>
            <header class="site-header">
                <div>
                    <p class="eyebrow">COMPETITIVE PROGRAMMING</p>
                    <h1>Termin</h1>
                    <p class="subtitle">Your friendly contest reminder.</p>
                </div>

                <div class="header-info">
                    <SyncStatus syncState={syncState} />
                    <div class="header-count">{contests.length} upcoming</div>
                    <a href="/settings" class="settings-link">
                        Settings
                    </a>
                </div>
            </header>

            {nextContest && (
                <ContestHero contest={nextContest} />
            )}

            <section>
                <div class="section-heading">
                    <h2>Upcoming contests</h2>
                    <span>{contests.length} total</span>
                </div>

                {groups.map((group) => (
                    <div class="day-group">
                        <p class="day-label">{group.label}</p>

                        <div class="contest-list">
                            {group.contests.map((contest) => (
                                <ContestCard contest={contest} />
                            ))}
                        </div>
                    </div>
                ))}
            </section>
        </main>
    </body>
</html>

<style>
    .settings-link {
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 150ms ease;
    }

    .settings-link:hover {
        color: var(--text);
        text-decoration: underline;
        text-underline-offset: 4px;
    }
</style>
