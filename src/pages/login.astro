---
import "../styles/global.css";
import {
  isAuthEnabled,
  isAuthenticated,
} from "../lib/auth/session";

const params = Astro.url.searchParams;
const rawNext = params.get("next");
const next =
  rawNext && rawNext.startsWith("/") && !rawNext.startsWith("//")
    ? rawNext
    : "/";
const failed = params.has("error");

if (!isAuthEnabled() || isAuthenticated(Astro.request)) {
  return Astro.redirect(next);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Sign in — Termin</title>
  </head>

  <body class="login-body">
    <main class="login-card">
      <div class="login-brand">
        <svg
          width="18"
          height="18"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <circle
            cx="8"
            cy="8"
            r="6.25"
            stroke="currentColor"
            stroke-width="1.5"></circle>
          <path
            d="M8 4.75V8.25L10.25 9.75"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span>Termin</span>
      </div>

      <h1>Sign in</h1>
      <p class="login-subtitle">
        This dashboard is private. Enter the password to continue.
      </p>

      <form method="POST" action="/api/login">
        <input type="hidden" name="next" value={next} />

        <label for="password">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          autofocus
        />

        {failed && <p class="login-error">That password was not right.</p>}

        <button class="btn btn-primary" type="submit">Unlock</button>
      </form>
    </main>
  </body>
</html>

<style>
  .login-body {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    background: var(--bg);
  }

  .login-card {
    width: 100%;
    max-width: 340px;
    display: grid;
    gap: 10px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .login-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }

  h1 {
    margin: 6px 0 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text);
  }

  .login-subtitle {
    margin: 0 0 6px;
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  form {
    display: grid;
    gap: 8px;
  }

  label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  input {
    height: 34px;
    padding: 0 10px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface-elevated);
    color: var(--text);
    font-family: inherit;
    font-size: 0.875rem;
  }

  input:focus {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  .btn {
    margin-top: 4px;
    height: 34px;
  }

  .login-error {
    margin: 0;
    color: var(--danger, #e5484d);
    font-size: 0.75rem;
  }
</style>
