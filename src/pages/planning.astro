---
import Layout from "../components/Layout.astro";
import ContestCard from "../components/ContestCard.astro";
import {
  getUpcomingStoredContests,
  getPrioritizedContestIds,
} from "../lib/contests/repository";
import { getPreferences } from "../lib/preferences/repository";
import {
  calculateRecommendations,
  getWeeklyCapacity,
  type Recommendation,
} from "../lib/contests/recommendations";
import { calculateBehavioralInsights } from "../lib/contests/insights";
import type { ContestPlatform } from "../lib/contests/types";

const preferences = getPreferences();
const contests = getUpcomingStoredContests(preferences.enabledPlatforms);
const prioritizedIds = getPrioritizedContestIds();
const recommendations = calculateRecommendations(
  contests,
  preferences,
  prioritizedIds
);
const capacity = getWeeklyCapacity(contests, prioritizedIds, preferences);
const insights = calculateBehavioralInsights();

const PLATFORM_NAMES: Record<string, string> = {
  codeforces: "Codeforces",
  atcoder: "AtCoder",
  codechef: "CodeChef",
  leetcode: "LeetCode",
};

const priorityClass: Record<Recommendation["priorityLabel"], string> = {
  High: "chip-accent",
  Medium: "",
  Low: "",
  None: "",
};

const topPlatform = insights.platformDistribution[0];
---

<Layout
  title="Planning — Termin"
  active="planning"
  description="A recommended order for this week's contests."
>
  <div class="page-head">
    <div>
      <h1>Planning</h1>
      <p class="subtitle">Ranked by your platforms, hours, and history.</p>
    </div>

    <div class="capacity">
      <span class="capacity-label">Capacity</span>
      <span class="capacity-value">
        {capacity.remaining}<span class="slash">/</span>{capacity.total}
      </span>
    </div>
  </div>

  <section>
    <div class="section-heading">
      <h2>Recommended</h2>
      <span>{recommendations.length} contests</span>
    </div>

    {recommendations.length === 0 ? (
      <div class="empty-state">
        <h3>Nothing to plan yet</h3>
        <p>
          Use the <code>Sync</code> button in the top bar to load upcoming
          contests, then set your platforms in Settings.
        </p>
      </div>
    ) : (
      <div class="rec-list">
        {recommendations.map((rec, index) => (
          <div class="rec">
            <ContestCard contest={rec.contest} />

            <div class="rec-details">
              <span class="rank">{index + 1}</span>

              {rec.priorityLabel !== "None" && (
                <span class:list={["chip", priorityClass[rec.priorityLabel]]}>
                  {rec.priorityLabel} priority
                </span>
              )}

              {rec.isConflict && (
                <span class="chip chip-warning">
                  Overlaps a prioritized contest
                </span>
              )}

              {rec.reasons.length > 0 && (
                <ul class="reasons">
                  {rec.reasons.map((reason) => (
                    <li>{reason}</li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <div slot="rail">
    <section class="card">
      <h2 class="card-title">Insights</h2>

      <dl class="stats">
        <div class="stat">
          <dt>Participation rate</dt>
          <dd>
            {insights.participationRate.rate.toFixed(0)}%
            <span class="stat-meta">
              {insights.participationRate.actualParticipated}/
              {insights.participationRate.totalPlanned} planned
            </span>
          </dd>
        </div>

        <div class="stat">
          <dt>Most tracked platform</dt>
          <dd>
            {topPlatform ? PLATFORM_NAMES[topPlatform.platform] ?? topPlatform.platform : "—"}
            {topPlatform && (
              <span class="stat-meta">
                {topPlatform.percentage.toFixed(0)}% of history
              </span>
            )}
          </dd>
        </div>

        <div class="stat">
          <dt>Recorded contests</dt>
          <dd>{insights.sampleSize}</dd>
        </div>
      </dl>
    </section>

    <section class="card">
      <h2 class="card-title">Preferences</h2>
      <ul class="prefs">
        <li>
          <span>Platforms</span>
          <span class="pref-value">{preferences.enabledPlatforms.length}</span>
        </li>
        <li>
          <span>Weekly cap</span>
          <span class="pref-value">{preferences.maxContestsPerWeek}</span>
        </li>
        <li>
          <span>Preferred days</span>
          <span class="pref-value">
            {preferences.preferredDays
              .map((day) => ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][day])
              .join(" ")}
          </span>
        </li>
      </ul>
      <a class="btn prefs-link" href="/settings">Edit preferences</a>
    </section>
  </div>
</Layout>

<style>
  .capacity {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .capacity-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .capacity-value {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }

  .capacity-value .slash {
    color: var(--text-dim);
    margin: 0 1px;
  }

  .rec-list {
    display: grid;
    gap: 10px;
  }

  .rec {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  .rec-details {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 14px;
    border-top: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--surface-elevated) 60%, var(--surface));
  }

  .rank {
    display: grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 4px;
    border-radius: var(--radius-sm);
    background: var(--surface-hover);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .reasons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.6875rem;
    color: var(--text-dim);
  }

  .reasons li + li::before {
    content: "·";
    margin-right: 6px;
    color: var(--border-strong);
  }

  .stats {
    margin: 0;
    display: grid;
    gap: 12px;
  }

  .stat {
    display: grid;
    gap: 2px;
  }

  .stat dt {
    font-size: 0.6875rem;
    color: var(--text-dim);
  }

  .stat dd {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }

  .stat-meta {
    margin-left: 8px;
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--text-dim);
  }

  .prefs {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 0.8125rem;
  }

  .prefs li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--text-muted);
  }

  .pref-value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
  }

  .prefs-link {
    width: 100%;
  }
</style>
